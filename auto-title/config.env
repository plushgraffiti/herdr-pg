# Auto Title configuration, from upstream's config.env.example (release 0.22.2).
# install.sh copies it to ~/.config/herdr-auto-title/config.env when no file is
# there yet; it never overwrites one. The service reads it once at startup, and
# does not see your shell's environment, so settings belong here.
#
# A commented line is the default. The lines changed from upstream's defaults:
#   HERDR_AUTO_TITLE_POSITION=false
#   HERDR_AUTO_TITLE_BRANCH_MAX=0
#   HERDR_AUTO_TITLE_DIRECTORY_MAX=0

# Log at DEBUG rather than INFO.
#HERDR_AUTO_TITLE_DEBUG=false

# How often the session is read, in milliseconds.
#HERDR_AUTO_TITLE_POLL_MS=500

# Longest title, in columns of the tab bar.
#HERDR_AUTO_TITLE_MAX_LENGTH=50

# Longest branch name a title may carry, in columns. 0 leaves branches out.
HERDR_AUTO_TITLE_BRANCH_MAX=0

# Longest directory name a tab title may carry, in columns. Unbounded by
# default; 0 leaves it out of every tab title that has something else to say.
# Pane labels keep the directory whole.
HERDR_AUTO_TITLE_DIRECTORY_MAX=0

# Put each tab's position in front of its title.
HERDR_AUTO_TITLE_POSITION=false

# Where tabs you renamed by hand are remembered. Defaults to manual-names.json,
# looked for in the same order as this file; write the path in full, "~" is not
# expanded here. Set it to nothing to keep those tabs in memory only.
#HERDR_AUTO_TITLE_MANUAL_FILE=/home/you/.config/herdr-auto-title/manual-names.json

# Read an agent's own session transcript when it has not titled its terminal.
#HERDR_AUTO_TITLE_TRANSCRIPT=true

# Only mirror native session names; leave unnamed shells/processes alone.
# Hermes waits for llm/user provenance, never its provisional derived title.
# Claude/Pi/Codex skip opening prompts; other stored titles have no provenance check.
#HERDR_AUTO_TITLE_SESSION_ONLY=false

# Extra absolute Hermes homes, including named profiles; ":"-separated (";" on Windows).
# Defaults also search HERMES_HOME and ~/.hermes. No tilde expansion.
#HERDR_AUTO_TITLE_HERMES_HOMES=/home/you/client-hermes

# Put the agent's name in front of what an agent pane is doing. Turned off, a
# pane whose agent has reported nothing is named after its directory instead.
#HERDR_AUTO_TITLE_AGENT_NAME=false

# Name each pane as well as its tab, which is what Herdr's goto panel lists a
# pane by. Turned off, a poll reads one pane per tab instead of every pane.
#HERDR_AUTO_TITLE_PANES=true

# Name a tab after the pane running an agent even while another pane in it is
# focused, so an editor opened beside the agent does not take the title over.
#HERDR_AUTO_TITLE_PREFER_AGENT=false

# Put each pane's Herdr ID in front of its label, as "[w1:p2] api", so the pane
# a script or another agent should address is on screen. Needs PANES.
#HERDR_AUTO_TITLE_PANE_ID=false

# Put the name you gave a pane's agent with `herdr agent rename` in front of
# its label, as "driver › api", after the ID when both are on. A pane whose
# agent has no name is labelled as before. Needs PANES.
#HERDR_AUTO_TITLE_AGENT_HANDLE=false

# Put a Nerd Font icon for what a pane runs (agent, editor, git, ssh, shell...)
# in front of its tab and pane labels. Needs a Nerd Font 3.0 or later; without
# one each icon is a box.
#HERDR_AUTO_TITLE_ICONS=false

# Put a mark for what the tab's agents are doing in front of its title:
# ◉ idle, ◐ working, ● blocked, ✓ done. Every change of status renames the tab.
#HERDR_AUTO_TITLE_AGENT_STATUS=false

# Report what each workspace's active tab is doing as a `topic` token. Herdr
# draws it only where your sidebar rows ask for "$topic" (see the README), and
# the workspace's own label is never touched.
#HERDR_AUTO_TITLE_WORKSPACES=true

# Longest topic, in columns. Unset by default, which lets Herdr fit the topic
# to the sidebar; a number cuts it to that many columns first.
#HERDR_AUTO_TITLE_WORKSPACE_MAX_LENGTH=30

# Other Claude Code configuration directories to read agent transcripts from,
# searched after the one CLAUDE_CONFIG_DIR names and separated by ":" (";" on
# Windows). A home your shell chooses per directory cannot be found on its own.
# One that does not exist yet is warned about and still searched.
#HERDR_AUTO_TITLE_CLAUDE_DIRS=/home/you/.claude-work:/home/you/.claude-other

# Programs that own their own tab and pane labels, so Auto Title leaves them
# alone, colon-separated (semicolon on Windows). herdr-mirror's streamer is
# identified without this and does not need listing.
#HERDR_AUTO_TITLE_FOREIGN_PROCESSES=
